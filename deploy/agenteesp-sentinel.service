[Unit]
Description=agenteEsp - Sentinel de bloqueio de agentes nao autorizados
After=network.target

[Service]
Type=simple
# Modo AUDITORIA por padrao. Para efetivamente encerrar os processos,
# acrescente --bloquear ao ExecStart apos validar os eventos registrados.
ExecStart=/usr/bin/agenteesp --config /etc/agenteesp/assinaturas.json sentinel \
    --intervalo 3 \
    --eventos /var/log/agenteesp/eventos.jsonl \
    --log-arquivo /var/log/agenteesp/sentinel.log
Restart=on-failure
RestartSec=5
# Precisa de privilegios para ver/encerrar processos de outros usuarios
User=root

[Install]
WantedBy=multi-user.target
